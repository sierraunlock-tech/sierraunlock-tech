# =====================================================================
# SIERRAUNLOCK • ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ---------------------------------------------------------------------
# INSTRUCTIONS:
# 1. Copy this to .env for local development (NEVER commit real .env)
# 2. In Render: Dashboard → Your Service → Environment → Add these
# 3. Replace placeholder values with your real credentials
# 4. Keep real secrets PRIVATE - never share or commit them
# =====================================================================

# 1. CORE SERVER SETTINGS
PORT=3000
FRONTEND_URL=https://sierraunlock.com,https://sierraunlock-tech.github.io

# 2. FASTUNLOCKERS API (Reseller Account)
UNLOCK_API_URL=https://fastunlockers.us/api/dhru
UNLOCK_API_USERNAME=your_username_here
UNLOCK_API_KEY=your_api_key_here

# 3. ADMIN & SECURITY
ADMIN_TOKEN=your_super_secret_admin_token_here

# 4. GITHUB VAULT (Persistent Data Backup)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_DATA_REPO=your_github_username/your_data_repo_name

# 5. PAYMENT & WEBHOOKS
BINANCE_WEBHOOK_SECRET=your_binance_webhook_secret_here
CDR_REPLY_KEY=your_cdr_reply_key_here
OM_TRUSTED_PHONES=23275908206

# 6. EMAILJS (For Account Verification OTPs)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# 7. BUSINESS LOGIC (Optional - defaults built into server.js)
UNLOCK_FLAT_FEE=2
UNLOCK_COMMISSION_SPLIT=0.75,0.25